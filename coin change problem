
int main()
{
    int coins[] = {1, 2, 5};
    int n = 3;
    int amount = 11;

    int dp[100];

    dp[0] = 0;


    for (int i = 1; i <= amount; i++)
        dp[i] = 9999;

  
    for (int i = 1; i <= amount; i++)
    {
        for (int j = 0; j < n; j++)
        {
            if (coins[j] <= i)
            {
                dp[i] = min(dp[i],
                            dp[i - coins[j]] + 1);
            }
        }
    }

    cout << "Minimum number of coins = "
         << dp[amount];

    return 0;
}
